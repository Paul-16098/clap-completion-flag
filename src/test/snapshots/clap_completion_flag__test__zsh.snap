---
source: src/test/mod.rs
expression: "String::from_utf8(f).expect(\"failed to convert bytes to string\")"
---
#compdef test

autoload -U is-at-least

_test() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--generate-completion=[Generate shell completion script to stdout and exit]:Shell:(bash elvish fish nushell powershell zsh carapace-spec)' \
'-f[]' \
'--flag-a[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
}

(( $+functions[_test_commands] )) ||
_test_commands() {
    local commands; commands=()
    _describe -t commands 'test commands' commands "$@"
}

if [ "$funcstack[1]" = "_test" ]; then
    _test "$@"
else
    compdef _test test
fi
